[Unit]
Description=com-klodnicki-pydt-notifier

StartLimitIntervalSec=0

[Service]
ExecStart=/bin/bash -c '. .nvm/nvm.sh && nvm use "$(< node_modules/com-klodnicki-pydt-notifier/.nvmrc)" && node node_modules/.bin/com-klodnicki-pydt-notifier ../.config/com-klodnicki-pydt-notifier/config.json'
WorkingDirectory=/var/www/com/klodnicki/pydt-notifier/api

Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
Alias=com-klodnicki-pydt-notifier.service
