{
  "name": "Node 26 Dev Container",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5-26",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.vscode-pull-request-github"
      ]
    }
  },
  "postCreateCommand": "npm ci || true"
}
